{
  "name": "veda-ai-assessment-creator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @veda/web",
    "dev:web": "npm run dev -w @veda/web",
    "build": "npm run build -w @veda/web",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "npm run lint -ws --if-present"
  },
  "dependencies": {
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vitest": "^3.1.4"
  }
}
