{
  "name": "veda-ai-assessment-creator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @veda/web",
    "dev:web": "npm run dev -w @veda/web",
    "dev:api": "npm run dev -w @veda/api",
    "dev:worker": "npm run dev -w @veda/worker",
    "dev:all": "concurrently \"npm run dev -w @veda/web\" \"npm run dev -w @veda/api\" \"npm run dev -w @veda/worker\"",
    "build": "npm run build -w @veda/web",
    "build:all": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vitest": "^3.1.4"
  }
}
